NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — embedded Elements checkout (no webhook required for basic flow)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PLAN_AMOUNT_CENTS=9900

# Optional: webhook for backup sync if user closes browser before complete-payment runs
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Phase 4 — Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=HealthBridge <billing@yourdomain.com>
EMAIL_REPLY_TO=care@yourdomain.com
EMAIL_WEBHOOK_SECRET=your-inbound-webhook-secret
